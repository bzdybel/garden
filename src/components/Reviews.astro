---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../config/site';

interface Props {
  limit?: number;
  index?: number;
}
const { limit = 3, index } = Astro.props;
const reviews = (await getCollection('opinie')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, limit);
---

{/* Sekcja ukryta, dopóki w site.ts nie ma prawdziwych opinii (rating.published) */}
{site.rating.published && (
<section class="section bg-mist" aria-labelledby="reviews-heading">
  <div class="container-x">
    <SectionHeading index={index} label="Opinie klientów" title={['Polecają nas', 'sąsiedzi']} id="reviews-heading">
      <p class="mt-6 flex items-center gap-3 text-sm">
        <span class="flex">{Array.from({ length: 5 }, () => <Icon name="star" class="size-4" />)}</span>
        <a href={site.social.google} rel="noopener" class="underline-offset-4 hover:underline">
          {site.rating.value.toLocaleString('pl-PL')}/5 · {site.rating.count} opinii w Google
        </a>
      </p>
    </SectionHeading>
    <ul class="mt-16 grid gap-px bg-line md:grid-cols-3">
      {
        reviews.map((r, i) => (
          <li class="bg-mist" data-reveal style={`--reveal-delay:${i}`}>
            <figure class="flex h-full flex-col py-8 md:px-8 md:first:pl-0">
              <div class="flex" aria-label={`Ocena ${r.data.rating} na 5`}>
                {Array.from({ length: r.data.rating }, () => <Icon name="star" class="size-4" />)}
              </div>
              <blockquote class="mt-6 flex-1 text-lg leading-relaxed">„{r.data.text}”</blockquote>
              <figcaption class="mt-8 text-sm">
                <strong class="font-semibold">{r.data.author}</strong>
                <span class="text-muted"> · {r.data.city}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
)}
