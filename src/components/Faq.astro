---
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Najczęściej zadawane pytania' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section" aria-labelledby="faq-heading">
      <div class="container-x max-w-3xl">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-heading" class="mt-2 mb-8 text-3xl sm:text-4xl">
          {title}
        </h2>
        <div class="divide-y divide-black/10 border-y border-black/10">
          {items.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left font-semibold text-forest-900 [&::-webkit-details-marker]:hidden">
                <h3 class="font-sans text-base">{f.q}</h3>
                <Icon name="chevron" class="mt-0.5 size-5 shrink-0 transition-transform group-open:rotate-180" />
              </summary>
              <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
