---
import SectionHeading from './SectionHeading.astro';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  index?: number;
}
const { items, title = 'Najczęściej zadawane pytania', index } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section" aria-labelledby="faq-heading">
      <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
        <SectionHeading index={index} label="FAQ" title={title} id="faq-heading" />
        <div class="border-t border-ink lg:mt-2" data-reveal>
          {items.map((f) => (
            <details class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left [&::-webkit-details-marker]:hidden">
                <h3 class="text-2xl leading-snug">{f.q}</h3>
                <span class="relative mt-1.5 size-4 shrink-0" aria-hidden="true">
                  <span class="absolute inset-x-0 top-1/2 h-px bg-ink" />
                  <span class="absolute inset-y-0 left-1/2 w-px bg-ink transition-transform group-open:scale-y-0" />
                </span>
              </summary>
              <p class="max-w-2xl pb-6 leading-relaxed text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
