---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { phoneHref, site } from '../config/site';
import background from '../../tresci/zdjecia/uslugi/zadaszenia-tarasow.jpg';

interface Props {
  title?: string;
  /** Druga linia nagłówka, pisana kursywą w złocie */
  accent?: string;
  text?: string;
}
// Domyślne teksty: tresci/strony/wspolne.md (sekcja cta)
const { cta } = (await getEntry('wspolne', 'wspolne'))!.data;
const { title = cta.title, accent = cta.accent, text = cta.text } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink text-white">
  <Image src={background} alt="" aria-hidden="true" widths={[768, 1280, 1920]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover opacity-45" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/80 to-ink/20"></div>
  <div class="container-x grid min-h-[70vh] items-end gap-12 py-24 sm:py-32 lg:grid-cols-[1fr_auto]">
    <div>
      <p class="eyebrow flex items-center gap-4 text-gold" data-reveal><span class="h-px w-10 bg-current"></span>{site.name}</p>
      <h2 class="heading-xl mt-6 max-w-3xl text-white" data-reveal>
        {title} <br /><em class="text-gold-light">{accent}</em>
      </h2>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/75" data-reveal style="--reveal-delay:1">{text}</p>
    </div>
    <div class="flex flex-col gap-3" data-reveal style="--reveal-delay:2">
      <a href="/kontakt/#wycena" class="btn-gold py-4">Umów konsultację <Icon name="arrow-up-right" class="size-4" /></a>
      <a href={phoneHref} class="btn border border-white/40 py-4 text-white hover:border-gold hover:text-gold">
        <Icon name="phone" class="size-4" />{site.phone}
      </a>
    </div>
  </div>
</section>
