---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs: Crumb[];
}
const { title, lead, eyebrow, crumbs } = Astro.props;
---

<section class="border-b border-line">
  <div class="container-x pt-8 pb-16 sm:pb-24">
    <Breadcrumbs crumbs={[{ name: 'Strona główna', href: '/' }, ...crumbs]} />
    <div data-reveal class="mt-16 grid gap-8 lg:mt-24 lg:grid-cols-[1fr_minmax(0,28rem)] lg:items-end lg:gap-16">
      <div>
        {eyebrow && <p class="eyebrow mb-8">{eyebrow}</p>}
        <h1 class="text-5xl leading-[1.05] tracking-[-0.035em] sm:text-6xl lg:text-7xl">{title}</h1>
      </div>
      {lead && <p class="text-lg leading-relaxed text-muted">{lead}</p>}
    </div>
    <slot />
  </div>
</section>
