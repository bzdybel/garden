---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, phoneHref, site } from '../config/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-cream/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-6 lg:h-20">
    <Logo />

    <nav aria-label="Główna nawigacja" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3.5 py-2 text-sm font-medium transition-colors hover:bg-sand',
                  isActive(item.href) ? 'text-wood-700' : 'text-ink/80',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={phoneHref} class="flex items-center gap-2 text-sm font-semibold text-forest-900">
        <Icon name="phone" class="size-4" />
        {site.phone}
      </a>
      <a href="/kontakt/#wycena" class="btn-primary">Bezpłatna wycena</a>
    </div>

    <!-- Menu mobilne bez JavaScriptu -->
    <details class="group lg:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-full p-2 hover:bg-sand [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Otwórz menu</span>
        <Icon name="menu" class="size-6 group-open:hidden" />
        <Icon name="close" class="hidden size-6 group-open:block" />
      </summary>
      <nav
        aria-label="Menu mobilne"
        class="absolute inset-x-0 top-16 border-b border-black/5 bg-cream px-4 pt-2 pb-6 shadow-lg"
      >
        <ul class="divide-y divide-black/5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block py-3 text-base font-medium">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/kontakt/#wycena" class="btn-primary mt-4 w-full">Bezpłatna wycena</a>
      </nav>
    </details>
  </div>
</header>
