---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site';
import defaultOg from '../assets/images/og-default.jpg';

export interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: object;
}

const { title, description, image = defaultOg, imageAlt, type = 'website', noindex = false, publishedTime, modifiedTime, jsonLd } =
  Astro.props;

// Google ucina tytuły ok. 60 znaków – markę dopisujemy tylko wtedy, gdy się zmieści,
// żeby nie wypychać słów kluczowych z widocznej części wyniku.
const MAX_TITLE = 60;
const withBrand = `${title} | ${site.name}`;
const fullTitle = title.includes(site.name) || withBrand.length > MAX_TITLE ? title : withBrand;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, site.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="pl_PL" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? title} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

<meta name="geo.region" content={site.address.regionCode} />
<meta name="geo.placename" content={site.address.city} />
<meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
