---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatPrice } from '../lib/labels';

interface Props {
  service: CollectionEntry<'uslugi'>;
  /** Cena „od” na kaflu – domyślnie ukryta, żeby nie sprowadzać oferty do ceny */
  showPrice?: boolean;
  delay?: number;
  /** Większy kafel (np. pierwszy w siatce) */
  large?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { service, showPrice = false, delay = 0, large = false, headingLevel: H = 'h3' } = Astro.props;
const { data } = service;
---

<article
  class:list={['group relative isolate overflow-hidden bg-ink text-white', large ? 'h-full min-h-[28rem]' : 'h-full min-h-[22rem]']}
  data-reveal
  style={`--reveal-delay:${delay}`}
>
  <Image
    src={data.cover}
    alt={data.coverAlt}
    widths={[480, 720, 960, 1280]}
    sizes={large ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 40vw, 100vw'}
    class="absolute inset-0 -z-10 size-full object-cover transition duration-1000 ease-out group-hover:scale-105"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/30 to-black/0"></div>
  <a href={`/uslugi/${service.id}/`} class="flex h-full flex-col justify-between p-7 sm:p-9">
    <span class="font-display text-2xl text-gold">{String(data.order).padStart(2, '0')}</span>
    <span class="block">
      <H class:list={['text-white', large ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl']}>{data.name}</H>
      <span class="mt-3 block max-w-md text-sm leading-relaxed text-white/75">{data.description}</span>
      <span class="mt-6 flex items-center justify-between border-t border-white/20 pt-5">
        <span class="text-xs tracking-[0.2em] text-gold-light uppercase">{showPrice ? `od ${formatPrice(data.priceFrom)}` : 'Poznaj ofertę'}</span>
        <Icon name="arrow-up-right" class="size-5 text-gold transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
      </span>
    </span>
  </a>
</article>
