---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { serviceLabels } from '../lib/labels';

interface Props {
  project: CollectionEntry<'realizacje'>;
  headingLevel?: 'h2' | 'h3';
  delay?: number;
}
const { project, headingLevel: H = 'h3', delay = 0 } = Astro.props;
const { data } = project;
---

<article class="group" data-reveal style={`--reveal-delay:${delay}`}>
  <a href={`/realizacje/${project.id}/`} class="block">
    <div class="aspect-[4/3] overflow-hidden bg-stone">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="size-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    </div>
    <p class="mt-5 text-xs tracking-[0.2em] text-gold-deep uppercase">{serviceLabels[data.service]} · {data.city}</p>
    <H class="mt-2 text-2xl leading-snug decoration-gold underline-offset-4 group-hover:underline">{data.title}</H>
    <p class="mt-2 text-sm text-muted">{data.size} · {data.system}</p>
  </a>
</article>
