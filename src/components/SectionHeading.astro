---
import Icon from './Icon.astro';

interface Props {
  /** Numer sekcji, np. 1 → „01” */
  index?: number;
  label: string;
  /** Linie nagłówka – druga i kolejne pisane kursywą */
  title: string | string[];
  id?: string;
  as?: 'h1' | 'h2';
  action?: { href: string; label: string };
  light?: boolean;
}
const { index, label, title, id, as: H = 'h2', action, light = false } = Astro.props;
const [first, ...rest] = Array.isArray(title) ? title : [title];
---

<div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end" data-reveal>
  <div class="max-w-3xl">
    <p class:list={['eyebrow flex items-center gap-4', light && 'text-gold']}>
      {index !== undefined && <span class="font-display text-base tracking-normal not-italic">{String(index).padStart(2, '0')}</span>}
      <span class="h-px w-10 bg-current" aria-hidden="true"></span>
      {label}
    </p>
    <H id={id} class:list={['heading-xl mt-6', light && 'text-white']}>
      {first}
      {rest.map((l) => [' ', <br />, <em class:list={['italic', light ? 'text-gold-light' : 'text-gold-deep']}>{l}</em>])}
    </H>
    <slot />
  </div>
  {
    action && (
      <a href={action.href} class:list={['group shrink-0', light ? 'btn-gold' : 'btn-secondary']}>
        {action.label} <Icon name="arrow-up-right" class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    )
  }
</div>
