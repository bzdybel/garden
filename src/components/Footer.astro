---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mailHref, phoneHref, site } from '../config/site';
import { cities } from '../data/cities';

const services = (await getCollection('uslugi')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="bg-forest-900 text-cream/80">
  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-4">
      <Logo light />
      <p class="text-sm leading-relaxed">{site.description}</p>
    </div>

    <div>
      <p class="mb-4 font-display text-lg text-cream">Usługi</p>
      <ul class="space-y-2 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={`/uslugi/${s.id}/`} class="hover:text-white">
                {s.data.name}
              </a>
            </li>
          ))
        }
        <li><a href="/cennik/" class="hover:text-white">Cennik</a></li>
      </ul>
    </div>

    <div>
      <p class="mb-4 font-display text-lg text-cream">Obszar działania</p>
      <ul class="space-y-2 text-sm">
        {
          cities.map((c) => (
            <li>
              <a href={`/obszar-dzialania/${c.slug}/`} class="hover:text-white">
                Altany i wiaty {c.locative}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- NAP – identyczny jak w Profilu Firmy w Google -->
    <address class="space-y-3 text-sm not-italic">
      <p class="mb-4 font-display text-lg text-cream">Kontakt</p>
      <p class="flex gap-2">
        <Icon name="pin" class="mt-0.5 size-4 shrink-0" />
        <span>{site.name}<br />{site.address.street}<br />{site.address.postalCode} {site.address.city}</span>
      </p>
      <p><a href={phoneHref} class="flex items-center gap-2 hover:text-white"><Icon name="phone" class="size-4" />{site.phone}</a></p>
      <p><a href={mailHref} class="flex items-center gap-2 hover:text-white"><Icon name="mail" class="size-4" />{site.email}</a></p>
      <div class="flex gap-2">
        <Icon name="clock" class="mt-0.5 size-4 shrink-0" />
        <ul>{site.openingHours.map((h) => <li>{h.label}</li>)}</ul>
      </div>
    </address>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-3 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.legalName}. NIP {site.nip}</p>
      <ul class="flex flex-wrap gap-4">
        <li><a href="/o-nas/" class="hover:text-white">O nas</a></li>
        <li><a href="/obszar-dzialania/" class="hover:text-white">Obszar działania</a></li>
        <li><a href="/polityka-prywatnosci/" class="hover:text-white">Polityka prywatności</a></li>
        <li><a href={site.social.facebook} rel="noopener" class="hover:text-white">Facebook</a></li>
        <li><a href={site.social.instagram} rel="noopener" class="hover:text-white">Instagram</a></li>
      </ul>
    </div>
  </div>
</footer>

<!-- Pasek CTA na telefonach – najwięcej zapytań w tej branży to telefony z mobile -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-black/10 bg-cream/95 p-2 backdrop-blur lg:hidden">
  <a href={phoneHref} class="btn-secondary"><Icon name="phone" class="size-4" />Zadzwoń</a>
  <a href="/kontakt/#wycena" class="btn-primary">Bezpłatna wycena</a>
</div>
