---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { formatDate } from '../../lib/labels';

const articles = (await getCollection('poradnik')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const crumbs = [{ name: 'Poradnik', href: '/poradnik/' }];
---

<BaseLayout
  title="Poradnik – zadaszenia tarasów i pergole od A do Z"
  description="Przepisy, ceny, wypełnienia i inspiracje. Praktyczne porady o aluminiowych zadaszeniach tarasów, pergolach lamelowych i zabudowach szklanych."
  crumbs={crumbs}
>
  <PageHeader
    title="Poradnik – zadaszenia tarasów i pergole"
    lead="Zanim wybierzesz zadaszenie: przepisy, koszty, systemy i wypełnienia dachu. Piszemy o tym, o co najczęściej pytają nas klienci."
    crumbs={crumbs}
  />
  <section class="section">
    <ul class="container-x grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((a) => (
          <li>
            <article class="card group h-full">
              <a href={`/poradnik/${a.id}/`} class="block">
                <Image src={a.data.cover} alt={a.data.coverAlt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[16/10] w-full object-cover" />
                <div class="p-6">
                  <time datetime={a.data.published.toISOString()} class="text-xs text-muted">
                    {formatDate(a.data.published)}
                  </time>
                  <h2 class="mt-2 text-xl leading-snug group-hover:text-ink">{a.data.title}</h2>
                  <p class="mt-3 text-sm leading-relaxed text-muted">{a.data.description}</p>
                </div>
              </a>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
  <CtaBanner />
</BaseLayout>
