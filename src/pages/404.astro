---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../config/site';
---

<BaseLayout title="Nie znaleziono strony" description="Strona, której szukasz, nie istnieje lub została przeniesiona. Zobacz nasze altany, wiaty i zadaszenia." noindex>
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <p class="font-display text-7xl font-semibold text-wood-300">404</p>
      <h1 class="mt-4 text-4xl">Tej strony nie ma w naszym ogrodzie</h1>
      <p class="mt-4 text-muted">Mogła zostać przeniesiona. Spróbuj jednej z poniższych sekcji:</p>
      <ul class="mt-8 flex flex-wrap justify-center gap-2">
        <li><a href="/" class="btn-primary">Strona główna</a></li>
        {nav.map((n) => <li><a href={n.href} class="btn-secondary">{n.label}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
