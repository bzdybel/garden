---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { mailHref, site } from '../config/site';

const crumbs = [{ name: 'Polityka prywatności', href: '/polityka-prywatnosci/' }];
---

<BaseLayout title="Polityka prywatności" description={`Zasady przetwarzania danych osobowych i plików cookies w serwisie ${site.name}.`} crumbs={crumbs}>
  <PageHeader title="Polityka prywatności" crumbs={crumbs} />
  <!-- TODO: treść do weryfikacji przez prawnika przed publikacją -->
  <section class="section">
    <div class="container-x prose-garden max-w-3xl">
      <h2>1. Administrator danych</h2>
      <p>
        Administratorem danych osobowych jest {site.legalName}, {site.address.street}, {site.address.postalCode}
        {site.address.city}, NIP {site.nip}. Kontakt w sprawie danych: <a href={mailHref}>{site.email}</a>.
      </p>
      <h2>2. Cel i podstawa przetwarzania</h2>
      <p>
        Dane przesłane przez formularz kontaktowy (imię, telefon, e-mail, miejscowość, treść wiadomości) przetwarzamy w celu
        przygotowania wyceny i kontaktu w sprawie zapytania – na podstawie art. 6 ust. 1 lit. b RODO (działania przed
        zawarciem umowy) oraz art. 6 ust. 1 lit. f RODO (prawnie uzasadniony interes administratora).
      </p>
      <h2>3. Okres przechowywania</h2>
      <p>Dane przechowujemy przez czas niezbędny do obsługi zapytania, nie dłużej niż 12 miesięcy od ostatniego kontaktu, chyba że dojdzie do zawarcia umowy.</p>
      <h2>4. Odbiorcy danych</h2>
      <p>Dane mogą być przekazywane podmiotom świadczącym usługi hostingowe, pocztowe i obsługi formularzy, wyłącznie w zakresie niezbędnym do realizacji celu.</p>
      <h2>5. Twoje prawa</h2>
      <p>Masz prawo dostępu do danych, ich sprostowania, usunięcia, ograniczenia przetwarzania, przenoszenia, wniesienia sprzeciwu oraz skargi do Prezesa UODO.</p>
      <h2>6. Pliki cookies</h2>
      <p>Serwis nie używa cookies marketingowych bez Twojej zgody. Mapa Google na stronie kontaktowej ładuje się dopiero po kliknięciu.</p>
    </div>
  </section>
</BaseLayout>
