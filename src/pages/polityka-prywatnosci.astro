---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { fill } from '../lib/tresci';

const crumbs = [{ name: 'Polityka prywatności', href: '/polityka-prywatnosci/' }];
const page = (await getEntry('politykaPrywatnosci', 'polityka-prywatnosci'))!;
const t = page.data;
---

<BaseLayout title={t.seoTitle} description={t.description} crumbs={crumbs}>
  <PageHeader title={t.title} crumbs={crumbs} />
  <section class="section">
    <div class="container-x prose-garden max-w-3xl" set:html={fill(page.rendered?.html ?? '')} />
  </section>
</BaseLayout>
