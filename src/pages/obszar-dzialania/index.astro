---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { cities, extraArea } from '../../data/cities';
import { site } from '../../config/site';

const crumbs = [{ name: 'Obszar działania', href: '/obszar-dzialania/' }];
---

<BaseLayout
  title={`Obszar działania – altany i wiaty ${cities[0].locative} i okolicach`}
  description={`Budujemy drewniane altany, wiaty i zadaszenia ${cities[0].locative}, ${cities.slice(1, 4).map((c) => c.locative.replace(/^we? /, '')).join(', ')} i w promieniu ok. 60 km. Bezpłatny dojazd na pomiar.`}
  crumbs={crumbs}
>
  <PageHeader
    title="Obszar działania"
    lead={`Stolarnia i baza montażowa mieszczą się ${cities[0].locative}. Do klientów w promieniu ok. 60 km dojeżdżamy na pomiar bezpłatnie.`}
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container-x">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          cities.map((c) => (
            <li>
              <a href={`/obszar-dzialania/${c.slug}/`} class="card group flex h-full flex-col p-6">
                <span class="flex items-center gap-2 text-sm text-muted">
                  <Icon name="pin" class="size-4 text-wood-600" />
                  {c.distanceKm === 0 ? 'siedziba firmy' : `ok. ${c.distanceKm} km od ${site.address.cityGenitive}`}
                </span>
                <h2 class="mt-3 text-2xl group-hover:text-wood-600">{c.name}</h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{c.intro}</p>
                <span class="mt-4 flex items-center gap-2 text-sm font-semibold text-wood-600">
                  Altany i wiaty {c.locative} <Icon name="arrow" class="size-4" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-muted">Pracujemy również m.in. w miejscowościach: {extraArea.join(', ')}.</p>
    </div>
  </section>
  <CtaBanner />
</BaseLayout>
