---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { cities } from '../../data/cities';

const crumbs = [{ name: 'Obszar działania', href: '/obszar-dzialania/' }];
const page = (await getEntry('obszarDzialania', 'obszar-dzialania'))!;
const t = page.data;
---

<BaseLayout
  title={t.seoTitle}
  description={t.description}
  crumbs={crumbs}
>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container-x">
      <ul class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          cities.map((c, i) => (
            <li class="bg-white" data-reveal style={`--reveal-delay:${i % 3}`}>
              <a href={`/obszar-dzialania/${c.slug}/`} class="group flex h-full flex-col p-8">
                <span class="eyebrow">{c.headquarters ? 'Siedziba firmy' : c.region}</span>
                <h2 class="mt-4 text-4xl">{c.name}</h2>
                <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{c.intro}</p>
                <span class="mt-6 flex items-center gap-2 text-xs font-medium tracking-[0.2em] uppercase">
                  Zadaszenia tarasów {c.locative}
                  <Icon name="arrow-up-right" class="size-4 text-gold-deep transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 max-w-2xl text-muted [&_a]:text-ink [&_a]:underline [&_a]:decoration-gold [&_a]:underline-offset-4" set:html={page.rendered?.html ?? ''} />
    </div>
  </section>
  <CtaBanner />
</BaseLayout>
