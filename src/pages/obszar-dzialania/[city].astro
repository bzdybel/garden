---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Faq from '../../components/Faq.astro';
import ContactForm from '../../components/ContactForm.astro';
import { cities, type City } from '../../data/cities';
import { businessId, faqSchema } from '../../lib/schema';
import { phoneHref, site } from '../../config/site';

export const getStaticPaths = (() => cities.map((city) => ({ params: { city: city.slug }, props: { city } }))) satisfies GetStaticPaths;

interface Props {
  city: City;
}
const { city } = Astro.props;
const services = (await getCollection('uslugi')).sort((a, b) => a.data.order - b.data.order);
const allProjects = (await getCollection('realizacje')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const localProjects = allProjects.filter((p) => p.data.city === city.name);
// Gdy brak realizacji w danym mieście, pokazujemy najnowsze z regionu
const projects = (localProjects.length ? localProjects : allProjects).slice(0, 3);
const neighbours = cities.filter((c) => c.slug !== city.slug);

const path = `/obszar-dzialania/${city.slug}/`;
const crumbs = [
  { name: 'Obszar działania', href: '/obszar-dzialania/' },
  { name: city.name, href: path },
];
const faq = [
  {
    q: `Czy dojazd na pomiar ${city.locative} jest płatny?`,
    a:
      city.distanceKm === 0
        ? `Nie. ${city.name} to nasza siedziba – pomiar i wycena są zawsze bezpłatne.`
        : `Nie. ${city.name} leży ok. ${city.distanceKm} km od naszej stolarni – dojazd na pomiar i wycena są bezpłatne.`,
  },
  {
    q: `Jak szybko możecie zbudować altanę ${city.locative}?`,
    a: 'Od podpisania umowy do montażu mija zwykle 3–6 tygodni. Sam montaż na działce trwa 1–3 dni, w zależności od wielkości konstrukcji.',
  },
  {
    q: `Gdzie zgłosić budowę wiaty ${city.locative}?`,
    a: `Zgłoszenie składa się w organie administracji architektoniczno-budowlanej właściwym dla lokalizacji – dla tej lokalizacji jest to ${city.authority}. Przygotowujemy rysunki i opis potrzebny do zgłoszenia.`,
  },
];
const schema = [
  {
    '@type': 'Service',
    name: `Altany, wiaty i zadaszenia ${city.locative}`,
    provider: { '@id': businessId },
    areaServed: { '@type': 'City', name: city.name },
    serviceType: 'Budowa drewnianych konstrukcji ogrodowych',
  },
  faqSchema(faq),
];
---

<BaseLayout
  title={`Altany ogrodowe i wiaty ${city.locative} – na wymiar`}
  description={`Altany ogrodowe, wiaty samochodowe, pergole i zadaszenia tarasów z drewna ${city.locative} i okolicach. Bezpłatny pomiar, montaż w 1–3 dni.`}
  crumbs={crumbs}
  schema={schema}
>
  <PageHeader title={`Altany ogrodowe, wiaty i zadaszenia ${city.locative}`} lead={city.intro} crumbs={crumbs}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="#wycena" class="btn-primary px-8 py-4 text-base">Bezpłatna wycena {city.locative}</a>
      <a href={phoneHref} class="btn-secondary px-8 py-4 text-base"><Icon name="phone" class="size-4" />{site.phone}</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div class="prose-garden">
        <h2>Budujemy {city.locative} i okolicy</h2>
        <p>{city.local}</p>
        <p>
          Każdą konstrukcję przygotowujemy w naszej stolarni, a na miejscu jedynie ją montujemy. Dzięki temu prace na
          Twojej działce trwają krótko, a teren po montażu jest czysty.
        </p>
      </div>
      <div class="rounded-2xl bg-white p-6 ring-1 ring-black/5">
        <h2 class="text-xl">Obsługiwane miejscowości i dzielnice</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {city.areas.map((a) => <li class="rounded-full bg-cream px-3 py-1.5 text-sm">{a}</li>)}
        </ul>
        <p class="mt-6 text-sm text-muted">
          {city.distanceKm === 0 ? 'Siedziba firmy' : `Odległość od stolarni: ok. ${city.distanceKm} km`} · dojazd na pomiar bezpłatny
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="oferta">
    <div class="container-x">
      <h2 id="oferta" class="text-3xl sm:text-4xl">Co budujemy {city.locative}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="realizacje-lokalne">
    <div class="container-x">
      <h2 id="realizacje-lokalne" class="text-3xl sm:text-4xl">
        {localProjects.length ? `Nasze realizacje ${city.locative}` : 'Nasze realizacje w regionie'}
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <Faq items={faq} title={`Altany i wiaty ${city.locative} – pytania`} />

  <section class="section bg-sand/60">
    <div class="container-x grid items-start gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl sm:text-4xl">Wycena {city.locative}</h2>
        <p class="mt-4 leading-relaxed text-muted">Zostaw kontakt – oddzwonimy i umówimy bezpłatny pomiar na Twojej działce.</p>
        <p class="mt-8 font-display text-lg text-forest-900">Działamy także w:</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            neighbours.map((n) => (
              <li>
                <a href={`/obszar-dzialania/${n.slug}/`} class="inline-block rounded-full bg-white px-3 py-1.5 text-sm hover:bg-sand">
                  {n.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
