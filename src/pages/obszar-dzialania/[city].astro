---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Faq from '../../components/Faq.astro';
import ContactForm from '../../components/ContactForm.astro';
import { cities, type City } from '../../data/cities';
import { businessId, faqSchema } from '../../lib/schema';
import { phoneHref, site } from '../../config/site';
import { cityVars, fill } from '../../lib/tresci';

export const getStaticPaths = (() => cities.map((city) => ({ params: { city: city.slug }, props: { city } }))) satisfies GetStaticPaths;

interface Props {
  city: City;
}
const { city } = Astro.props;
const services = (await getCollection('uslugi')).sort((a, b) => a.data.order - b.data.order);
const allProjects = (await getCollection('realizacje')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// Przykładowe realizacje nie są dowodem pracy w danym mieście
const localProjects = allProjects.filter((p) => p.data.city === city.name && !p.data.example);
// Gdy brak realizacji w danym mieście, pokazujemy najnowsze z całej Polski
const projects = (localProjects.length ? localProjects : allProjects).slice(0, 3);
const others = cities.filter((c) => c.slug !== city.slug);

const path = `/obszar-dzialania/${city.slug}/`;
const crumbs = [
  { name: 'Obszar działania', href: '/obszar-dzialania/' },
  { name: city.name, href: path },
];
const page = (await getEntry('miastaWspolne', 'miasta-wspolne'))!;
const t = page.data;
const vars = cityVars(city);
const f = (text: string) => fill(text, vars);
// Najpierw pytania lokalne z pliku miasta, potem wspólne
const faq = [
  ...city.faq.map((q) => ({ q: f(q.q), a: f(q.a) })),
  ...t.faq.map((q) => ({ q: f(q.q), a: f(city.headquarters && q.aHeadquarters ? q.aHeadquarters : q.a) })),
];
const schema = [
  {
    '@type': 'Service',
    name: `Aluminiowe zadaszenia tarasów i pergole ${city.locative}`,
    serviceType: 'Montaż aluminiowych zadaszeń tarasów i pergoli',
    provider: { '@id': businessId },
    areaServed: { '@type': 'City', name: city.name },
  },
  faqSchema(faq),
];
---

<BaseLayout
  title={f(t.seoTitle)}
  description={f(t.description)}
  crumbs={crumbs}
  schema={schema}
>
  <PageHeader eyebrow={city.region} title={f(t.title)} lead={city.intro} crumbs={crumbs}>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="#wycena" class="btn-gold py-4">Bezpłatna wycena <Icon name="arrow-up-right" class="size-4" /></a>
      <a href={phoneHref} class="btn-secondary py-4"><Icon name="phone" class="size-4" />{site.phone}</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="container-x grid gap-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-24">
      <div class="prose-garden" data-reveal>
        <h2>{f(t.localTitle)}</h2>
        <p>{city.local}</p>
        <Fragment set:html={f(page.rendered?.html ?? '')} />
      </div>
      <div class="self-start border-t border-ink pt-8" data-reveal style="--reveal-delay:1">
        <h2 class="text-3xl">{f(t.areasTitle)}</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {city.areas.map((a) => <li class="border border-line px-3 py-1.5 text-sm">{a}</li>)}
        </ul>
        <p class="mt-8 text-sm text-muted">
          {city.headquarters ? 'Siedziba firmy' : `Montaż ${city.locative} realizujemy z naszej siedziby w Radomiu`} · {city.region}
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="oferta">
    <div class="container-x">
      <SectionHeading label={t.offer.label} title={t.offer.title.map(f)} id="oferta" />
      <div class="mt-16 grid auto-rows-[minmax(22rem,auto)] gap-4 md:grid-cols-2">
        {services.map((s, i) => <ServiceCard service={s} delay={i % 2} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="realizacje-lokalne">
    <div class="container-x">
      <SectionHeading
        label="Realizacje"
        title={localProjects.length ? ['Nasze realizacje', city.locative] : projects.every((p) => p.data.example) ? ['Przykładowe', 'realizacje'] : ['Nasze realizacje', 'w całej Polsce']}
        id="realizacje-lokalne"
        action={{ href: '/realizacje/', label: 'Wszystkie realizacje' }}
      />
      <div class="mt-16 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => <ProjectCard project={p} delay={i} />)}
      </div>
    </div>
  </section>

  <Faq items={faq} title={f(t.faqTitle)} />

  <section class="section bg-mist">
    <div class="container-x grid items-start gap-12 lg:grid-cols-2 lg:gap-24">
      <div>
        <SectionHeading label={t.quote.label} title={t.quote.title.map(f)} />
        <p class="mt-8 leading-relaxed text-muted">{f(t.quote.text)}</p>
        <p class="mt-12 eyebrow">Montujemy także</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            others.map((n) => (
              <li>
                <a href={`/obszar-dzialania/${n.slug}/`} class="inline-block border border-line bg-white px-3 py-1.5 text-sm transition-colors hover:border-gold-deep">
                  {n.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
