---
import BaseLayout from '../layouts/BaseLayout.astro';
import { phoneHref, site } from '../config/site';
---

<BaseLayout title="Dziękujemy za zapytanie" description="Twoje zapytanie zostało wysłane. Odezwiemy się w ciągu 24 godzin roboczych." noindex>
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <p class="eyebrow">Wiadomość wysłana</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Dziękujemy za zapytanie!</h1>
      <p class="mt-6 text-lg text-muted">
        Odezwiemy się w ciągu 24 godzin roboczych. Jeśli sprawa jest pilna, zadzwoń: <a href={phoneHref} class="font-semibold text-ink">{site.phone}</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/realizacje/" class="btn-primary">Zobacz nasze realizacje</a>
        <a href="/poradnik/" class="btn-secondary">Przeczytaj poradnik</a>
      </div>
    </div>
  </section>
</BaseLayout>
