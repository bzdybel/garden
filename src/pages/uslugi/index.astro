---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Process from '../../components/Process.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { absoluteUrl } from '../../lib/schema';

const services = (await getCollection('uslugi')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Usługi', href: '/uslugi/' }];
const itemList = {
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: absoluteUrl(`/uslugi/${s.id}/`), name: s.data.name })),
};
---

<BaseLayout
  title="Oferta – zadaszenia tarasowe, pergole i zabudowy szklane"
  description="Aluminiowe zadaszenia tarasów, pergole ogrodowe i lamelowe, szklane ściany przesuwne, shuttersy i markizy dachowe. Projekt i montaż w całej Polsce."
  crumbs={crumbs}
  schema={[itemList]}
>
  <PageHeader
    title="Zadaszenia tarasowe, pergole i zabudowy z aluminium"
    lead="Zadaszenia, pergole, zabudowy i osłony – zaprojektowane jako jeden spójny system. Wybierz, od czego chcesz zacząć, a resztą zajmiemy się my."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container-x grid auto-rows-[minmax(24rem,auto)] gap-4 md:grid-cols-2">
      {services.map((s, i) => <ServiceCard service={s} showPrice delay={i % 2} headingLevel="h2" />)}
    </div>
  </section>
  <Process />
  <CtaBanner />
</BaseLayout>
