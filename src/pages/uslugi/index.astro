---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Process from '../../components/Process.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { absoluteUrl } from '../../lib/schema';

const services = (await getCollection('uslugi')).sort((a, b) => a.data.order - b.data.order);
const { data: t } = (await getEntry('oferta', 'oferta'))!;
const crumbs = [{ name: 'Usługi', href: '/uslugi/' }];
const itemList = {
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: absoluteUrl(`/uslugi/${s.id}/`), name: s.data.name })),
};
---

<BaseLayout
  title={t.seoTitle}
  description={t.description}
  crumbs={crumbs}
  schema={[itemList]}
>
  <PageHeader
    title={t.title}
    lead={t.lead}
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container-x grid auto-rows-[minmax(24rem,auto)] gap-4 md:grid-cols-2">
      {services.map((s, i) => <ServiceCard service={s} showPrice delay={i % 2} headingLevel="h2" />)}
    </div>
  </section>
  <Process />
  <CtaBanner />
</BaseLayout>
