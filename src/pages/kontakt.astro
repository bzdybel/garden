---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { mailHref, phoneHref, site } from '../config/site';
import { absoluteUrl, businessId } from '../lib/schema';

const crumbs = [{ name: 'Kontakt', href: '/kontakt/' }];
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.postalCode} ${site.address.city}`);
const contactPage = { '@type': 'ContactPage', url: absoluteUrl('/kontakt/'), about: { '@id': businessId } };
---

<BaseLayout
  title={`Kontakt – bezpłatna wycena zadaszenia tarasu`}
  description={`Zadzwoń ${site.phone} lub wypełnij formularz – bezpłatna wycena aluminiowego zadaszenia tarasu lub pergoli w 24 h. Siedziba w Radomiu, montaż w całej Polsce.`}
  crumbs={crumbs}
  schema={[contactPage]}
>
  <PageHeader
    title="Kontakt i bezpłatna wycena"
    lead="Opisz swój taras – odezwiemy się w ciągu 24 godzin roboczych, przygotujemy wstępną wycenę i umówimy pomiar."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div class="space-y-8">
        <ul class="space-y-5">
          <li>
            <a href={phoneHref} class="flex items-center gap-4">
              <span class="flex size-12 items-center justify-center bg-mist text-ink"><Icon name="phone" class="size-6" /></span>
              <span><span class="block text-sm text-muted">Telefon</span><strong class="text-lg">{site.phone}</strong></span>
            </a>
          </li>
          <li>
            <a href={mailHref} class="flex items-center gap-4">
              <span class="flex size-12 items-center justify-center bg-mist text-ink"><Icon name="mail" class="size-6" /></span>
              <span><span class="block text-sm text-muted">E-mail</span><strong class="text-lg">{site.email}</strong></span>
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex size-12 items-center justify-center bg-mist text-ink"><Icon name="pin" class="size-6" /></span>
            <address class="not-italic">
              <span class="block text-sm text-muted">Siedziba i biuro (montaż w całej Polsce)</span>
              <strong>{site.address.street}, {site.address.postalCode} {site.address.city}</strong>
            </address>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex size-12 items-center justify-center bg-mist text-ink"><Icon name="clock" class="size-6" /></span>
            <span><span class="block text-sm text-muted">Godziny otwarcia</span><strong>{site.openingHours.map((h) => h.label).join(', ')}</strong></span>
          </li>
        </ul>
        <p class="text-sm text-muted">{site.legalName} · NIP {site.nip}</p>
        <!-- Mapa ładowana dopiero po kliknięciu: zero zapytań do Google przy wejściu na stronę (szybkość + RODO) -->
        <div class="overflow-hidden ring-1 ring-black/5">
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
            rel="noopener"
            target="_blank"
            class="flex aspect-[4/3] flex-col items-center justify-center gap-3 bg-mist text-center"
            data-map-trigger
            data-map-src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          >
            <Icon name="pin" class="size-10 text-ink" />
            <span class="font-semibold">Pokaż mapę dojazdu</span>
            <span class="text-xs text-muted">Kliknięcie załaduje Mapy Google</span>
          </a>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector<HTMLAnchorElement>('[data-map-trigger]')?.addEventListener('click', (e) => {
    const link = e.currentTarget as HTMLAnchorElement;
    e.preventDefault();
    const iframe = document.createElement('iframe');
    iframe.src = link.dataset.mapSrc!;
    iframe.title = 'Mapa dojazdu';
    iframe.loading = 'lazy';
    iframe.className = 'aspect-[4/3] w-full border-0';
    link.replaceWith(iframe);
  });
</script>
