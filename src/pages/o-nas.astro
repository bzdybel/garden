---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { getEntry } from 'astro:content';
import { site } from '../config/site';
import { absoluteUrl, businessId } from '../lib/schema';
import { fill } from '../lib/tresci';

const crumbs = [{ name: 'O nas', href: '/o-nas/' }];
const page = (await getEntry('oNas', 'o-nas'))!;
const t = page.data;
const aboutPage = { '@type': 'AboutPage', url: absoluteUrl('/o-nas/'), about: { '@id': businessId } };
---

<BaseLayout
  title={t.seoTitle}
  description={t.description}
  image={t.image}
  imageAlt={t.imageAlt}
  crumbs={crumbs}
  schema={[aboutPage]}
>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-24">
      <Image src={t.image} alt={t.imageAlt} widths={[640, 960]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/5] w-full object-cover" data-reveal />
      <div class="prose-garden" data-reveal style="--reveal-delay:1" set:html={fill(page.rendered?.html ?? '')} />
    </div>
  </section>
  <section aria-label="Najważniejsze fakty" class="bg-slate text-white">
    <dl class="container-x grid grid-cols-2 gap-y-12 py-20 lg:grid-cols-4">
      {
        site.stats.map((s, i) => (
          <div class="flex flex-col border-l border-gold/40 pl-6" data-reveal style={`--reveal-delay:${i}`}>
            <dt class="mt-3 max-w-[12rem] text-sm leading-relaxed text-white/70">{s.label}</dt>
            <dd class="order-first font-display text-5xl text-gold sm:text-6xl">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>
  <Process />
  <Reviews />
  <section class="section border-t border-line">
    <div class="container-x">
      <SectionHeading label={t.values.label} title={t.values.title} />
    </div>
  </section>
  <CtaBanner />
</BaseLayout>
