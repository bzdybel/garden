---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbSchema, businessSchema, graph, websiteSchema, type Crumb } from '../lib/schema';

interface Props extends Omit<SeoProps, 'jsonLd'> {
  /** Okruszki – pierwszy element „Strona główna” dodawany automatycznie */
  crumbs?: Crumb[];
  /** Dodatkowe węzły schema.org dla tej podstrony */
  schema?: object[];
}

const { crumbs = [], schema = [], ...seo } = Astro.props;
const allCrumbs = crumbs.length ? [{ name: 'Strona główna', href: '/' }, ...crumbs] : [];
const jsonLd = graph(businessSchema(), websiteSchema(), ...(allCrumbs.length ? [breadcrumbSchema(allCrumbs)] : []), ...schema);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2f4f30" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col pb-16 lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:p-3">
      Przejdź do treści
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
